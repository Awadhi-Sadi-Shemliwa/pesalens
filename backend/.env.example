# =============================================================
# PesaLens backend configuration — copy to .env and edit values.
# Never commit the actual .env file.
# =============================================================

# Comma-separated list of frontend origins allowed by CORS.
# Production: lock to your real domain only, e.g.
#   ALLOWED_ORIGINS=https://app.pesalens.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Environment marker — switches docs visibility, HSTS header,
# secure-cookie defaults, etc.
ENVIRONMENT=development

# JWT signing secret. MUST be a long random string in production.
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-please-use-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Account lockout (per-email, layered on top of slowapi per-IP/user limits).
LOCKOUT_MAX_FAILS=10
LOCKOUT_WINDOW_MIN=15
LOCKOUT_DURATION_MIN=15

# Cookie hardening (set true in production, with HTTPS).
COOKIE_SECURE=false
COOKIE_DOMAIN=

# SQLite by default. Switch to postgres+asyncpg://… in production.
DATABASE_URL=sqlite:///./storage/pesalens.db

# Rate limits — per-user when authenticated, per-IP otherwise.
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_UPLOAD=10/hour
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_RECEIPTS=30/hour
RATE_LIMIT_ASSISTANT=60/hour

# OpenRouter (LLM + vision). Optional — only set if you want AI replies.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m2.5:free
OPENROUTER_VISION_MODELS=
OPENROUTER_TEXT_MODEL=

# Legacy Gemini key (kept blank by default).
GEMINI_API_KEY=

# Email transactional sender (Resend.com). Leave blank in dev to log
# verification + reset codes to stdout instead of sending real email.
RESEND_API_KEY=
# `EMAIL_FROM` MUST use a verified Resend domain. The default below points
# at the contact subdomain; override per environment as needed.
EMAIL_FROM=PesaLens <noreply@contact.pesalens.com>
EMAIL_REPLY_TO=support@contact.pesalens.com
EMAIL_VERIFY_TTL_MIN=15
PASSWORD_RESET_TTL_MIN=15

# Storage / processing limits.
STORAGE_DIR=storage
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=50
MAX_REQUEST_BODY_MB=60
ENABLE_LLM_REPAIR=false

# Auto-delete uploaded PDFs after extraction (true|false).
DELETE_PDF_AFTER_EXTRACTION=true

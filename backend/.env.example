# PesaLens backend — example environment file.
#
# Copy to backend/.env and fill in the values. .env is gitignored at the
# repo root and at backend/; do NOT commit real secrets.
#
# The full security/production checklist that used to live in this file
# is now at backend/SECURITY_CHECKLIST.md — read it before deploying.

# ---------- Auth / JWT ----------
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(64))"
# REQUIRED in production. In dev, leaving this blank generates a per-process
# secret (every backend restart logs everyone out — fine locally).
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Account lockout (brute-force defence layered on top of slowapi).
LOCKOUT_MAX_FAILS=10
LOCKOUT_WINDOW_MIN=15
LOCKOUT_DURATION_MIN=15

# ---------- Environment / cookies ----------
# Set ENVIRONMENT=production to engage the boot-time fail-fast checks
# in app/main.py (refuses to start if JWT_SECRET / COOKIE_SECURE /
# ALLOWED_ORIGINS / DATABASE_URL are still at dev defaults).
ENVIRONMENT=development
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Comma-separated list. Production should be ONLY your real origins —
# no localhost entries (the fail-fast catches those).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,capacitor://localhost,https://localhost

# ---------- Database ----------
# Empty value falls back to SQLite under storage/. For production set a
# Postgres DSN, e.g. postgresql+psycopg://user:pass@host:5432/pesalens
DATABASE_URL=

# ---------- Rate limits (slowapi syntax) ----------
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_UPLOAD=10/hour
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_RECEIPTS=30/hour
RATE_LIMIT_ASSISTANT=60/hour

# ---------- LLM providers ----------
# OPENROUTER drives the PesaLens AI chat (free MiniMax + Llama fallbacks).
# GEMINI drives vision / receipt OCR. Either alone is enough to run; both
# is preferred so the assistant stays up when one provider throttles.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_API_KEY=

# ---------- Storage / pipeline ----------
STORAGE_DIR=storage
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=50
MAX_REQUEST_BODY_MB=60
ENABLE_LLM_REPAIR=false
DELETE_PDF_AFTER_EXTRACTION=true

# Cap on the PDF unlock brute-forcer (6-digit numeric keyspace). Keeps a
# single request from soaking CPU. See SECURITY_CHECKLIST.md.
PDF_UNLOCK_MAX_SECONDS=30

# Per-user receipt image quota (MB) and image retention (days). JSON
# metadata is kept indefinitely so analytics still works after the image
# is purged.
RECEIPT_QUOTA_MB=500
RECEIPT_IMAGE_RETENTION_DAYS=90

# ---------- Email (Resend.com) ----------
# Leave RESEND_API_KEY blank in dev to log verification / reset codes to
# stdout instead of sending real email.
RESEND_API_KEY=
EMAIL_FROM=PesaLens <noreply@contact.pesalens.com>
EMAIL_REPLY_TO=
EMAIL_VERIFY_TTL_MIN=15
PASSWORD_RESET_TTL_MIN=15
PASSWORD_CHANGE_REVOKE_TTL_MIN=1440

# ---------- Trial / billing ----------
TRIAL_DAYS=14
PRO_MONTHLY_PRICE=14900
PRO_YEARLY_PRICE=149000
PRO_CURRENCY=TZS
BILLING_PROVIDER=manual
PUBLIC_APP_URL=http://localhost:5173
BILLING_ADMINS=

# Stripe (only when BILLING_PROVIDER=stripe).
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_WEBHOOK_SECRET=

# Manual M-Pesa / bank payout details. Empty values cause /billing/checkout
# to return a "contact us" message instead of fake account numbers.
MANUAL_LIPA_NAMBA=
MANUAL_BANK_NAME=
MANUAL_BANK_ACCOUNT=
MANUAL_BANK_HOLDER=
MANUAL_SUPPORT_CONTACT=

# Caddy reverse proxy in front of the FastAPI backend.
#
# Auto-TLS via Let's Encrypt. The {$API_DOMAIN} placeholder is filled
# from the .env at the repo root on the VPS (compose passes the env
# through automatically when the file is named `Caddyfile`).
#
# Health endpoint is reachable both via the public domain and on the
# container's internal port, so Caddy's own healthcheck can hit it
# without going through the proxy chain.

{
	# Email for Let's Encrypt expiry notifications. Overridden by
	# {$CADDY_ACME_EMAIL} from .env.
	email {$CADDY_ACME_EMAIL:awadhishemliwa@gmail.com}

	# In dev / staging set CADDY_STAGING=1 to use Let's Encrypt staging
	# (avoids burning prod rate limits while debugging DNS / firewall).
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$API_DOMAIN:api.pesalens.com} {
	encode zstd gzip

	# Block clients that send absurdly large bodies before they hit
	# gunicorn — backend caps at 60MB but we drop > 75MB at the edge.
	request_body {
		max_size 75MB
	}

	# Security headers (defence-in-depth; backend also sets these).
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Remove the Server banner so we don't advertise the version.
		-Server
	}

	reverse_proxy backend:8000 {
		# Forward the real client IP so slowapi rate-limits per user, not
		# per Caddy container.
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}

		# Long-running PDF extractions can take a minute; match the
		# gunicorn --timeout in backend/Dockerfile.
		transport http {
			read_timeout 120s
			write_timeout 120s
		}
	}

	log {
		output stdout
		format console
	}
}

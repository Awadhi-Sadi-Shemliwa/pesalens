# Production-only Vite env. Loaded automatically by `vite build` when no
# explicit --mode is passed (the default mode for `vite build` is
# production, so this file is the one that ships in a release APK).
#
# This file is committed (tracked). Do NOT put secrets here — anything
# prefixed with VITE_ is inlined into the JS bundle and visible to
# anyone who unzips the APK.

# Public API URL shipped in the release APK.
#
# The production backend is served single-origin behind NGINX at
# pesalens.com, with the API mounted under /api (see deploy/README.md).
# The native APK can't use a relative path, so it points at the absolute
# public endpoint.
VITE_API_URL=https://pesalens.com/api

# Locks the in-app "Configure server" screen off in release builds.
# When set to `prod`, src/App.tsx + src/pages/More.tsx + src/pages/SignIn.tsx
# hide their dev-only backend override entry points.
VITE_PESALENS_BUILD=prod

<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-variant network policy.

  Gradle merges resources per build type, so this file SHADOWS the strict
  policy in `src/main/res/xml/network_security_config.xml` only when
  building `assembleDebug`. Release builds (`assembleRelease`) never see
  this file and keep the HTTPS-only + pinned production posture.

  Why a separate file instead of just `<debug-overrides>` in main:
  ERR_CLEARTEXT_NOT_PERMITTED on WebView fetch() persisted even after we
  added `<debug-overrides cleartextTrafficPermitted="true">` to the main
  config. Some Chromium WebView versions don't honour `debug-overrides`
  for fetch initiated from JS — the policy is evaluated against the
  base/domain-config layer first. Resolving the entire policy at the
  base for debug builds is the only reliable answer.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>

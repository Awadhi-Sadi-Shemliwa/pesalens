<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ data-extraction policy. We disallow cloud + device-transfer
  backups because the app holds financial data and auth tokens. Users who
  want continuity sign back in on a new device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

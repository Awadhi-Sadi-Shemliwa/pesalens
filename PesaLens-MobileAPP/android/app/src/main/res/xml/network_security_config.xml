<?xml version="1.0" encoding="utf-8"?>
<!--
  Production network policy:
    • All traffic must be HTTPS to pesalens.com (and subdomains).
    • No user-installed CAs are trusted (defeats casual MITM via a rogue
      profile).
    • Cleartext is allowed only on debug builds, via the debug-overrides
      block, so a developer can point at a laptop on the same Wi-Fi.

  Certificate pinning is INTENTIONALLY DEFERRED for the initial launch.
  A pin is a SHA-256 hash of the production server's public key. HTTPS-only
  is still enforced by `cleartextTrafficPermitted="false"`, and the system
  CA store still validates the chain — that's the same starting posture
  every Play Store app ships with.

  Now that the API is live with HTTPS at pesalens.com, you can re-add a
  `<pin-set>` block inside `<domain-config>` with TWO real pins (primary +
  backup) so cert rotations don't break the app:

      openssl s_client -connect pesalens.com:443 \
        -servername pesalens.com </dev/null 2>/dev/null \
        | openssl x509 -pubkey -noout \
        | openssl pkey -pubin -outform DER \
        | openssl dgst -sha256 -binary | openssl enc -base64

  Run once for the live cert, once for the Let's Encrypt intermediate
  (R3 or E1), pick an `expiration` ~12 months out, and ship an APK
  update. Re-enable the pin-placeholder check in
  scripts/release-guard.mjs at the same time.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">pesalens.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Debuggable APKs (assembleDebug) get a relaxed policy so a tester
         can point the build at a LAN dev backend like
         http://192.168.x.x:8000/api. `cleartextTrafficPermitted="true"`
         here only applies when android:debuggable=true, so release APKs
         keep the strict HTTPS-only base-config above. Without this,
         Android refuses the HTTP request before it ever leaves the
         WebView and the UI shows "Failed to fetch". -->
    <debug-overrides cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>

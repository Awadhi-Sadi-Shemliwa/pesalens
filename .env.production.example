# =============================================================
# PesaLens — Contabo / production .env template.
#
# Copy to `.env` on the VPS (NOT committed), fill every value, then
# `docker compose up -d`. The boot-time check in app/main.py refuses
# to start if any prod-required field is still at its dev default,
# so a misconfigured deploy fails loud instead of silent.
#
# Generate secrets with:
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
# =============================================================

# ---------- Compose / infra ----------
# Public DNS name pointed at the VPS. Caddy uses this to provision TLS.
API_DOMAIN=api.pesalens.com
# Email used by Let's Encrypt for expiry notices.
CADDY_ACME_EMAIL=
# Host path where uploads, OCR debug dumps, and receipt images are
# persisted. MUST exist on the host and be chown'd to uid:gid 10001:10001
# (the non-root user the backend container runs as).
STORAGE_HOST_PATH=/opt/pesalens/storage

# ---------- Postgres ----------
POSTGRES_DB=pesalens
POSTGRES_USER=pesalens
# REQUIRED. Long random string — never reuse a password from another service.
POSTGRES_PASSWORD=

# ---------- Backend ----------
ENVIRONMENT=production

# JWT signing secret. MUST be set — defaults to per-process random which
# logs everyone out on every restart.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Cookie + CORS — these MUST match the real frontend origins.
COOKIE_SECURE=true
COOKIE_DOMAIN=.pesalens.com
ALLOWED_ORIGINS=https://app.pesalens.com,https://pesalens.com

# Rate limits (slowapi syntax).
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_UPLOAD=10/hour
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_RECEIPTS=30/hour
RATE_LIMIT_ASSISTANT=60/hour

# Account lockout.
LOCKOUT_MAX_FAILS=10
LOCKOUT_WINDOW_MIN=15
LOCKOUT_DURATION_MIN=15

# ---------- LLM providers ----------
# Both optional individually — keep at least one set in prod so the
# assistant + receipt OCR stay alive when the other throttles.
OPENROUTER_API_KEY=
# Leave blank to use the code default (qwen3-next-80b-a3b-instruct:free).
# Override only when you want to pin a specific paid model (e.g.
# anthropic/claude-sonnet-4) for the chat path.
OPENROUTER_MODEL=
GEMINI_API_KEY=

# ---------- Email (Resend.com) ----------
# Required in production — verification codes + password resets go
# through Resend. Leave blank only for dev (codes log to stdout).
# Get a key at https://resend.com/api-keys after verifying the
# contact.pesalens.com sending domain.
RESEND_API_KEY=
EMAIL_FROM=PesaLens <noreply@contact.pesalens.com>
# Replies must NOT land in a personal mailbox. Set up Cloudflare
# Email Routing (or a real mailbox) for support@.
EMAIL_REPLY_TO=support@pesalens.com
EMAIL_VERIFY_TTL_MIN=15
PASSWORD_RESET_TTL_MIN=15
PASSWORD_CHANGE_REVOKE_TTL_MIN=1440

# ---------- Storage / pipeline ----------
STORAGE_DIR=storage
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=50
MAX_REQUEST_BODY_MB=60
ENABLE_LLM_REPAIR=false
DELETE_PDF_AFTER_EXTRACTION=true
PDF_UNLOCK_MAX_SECONDS=30
RECEIPT_QUOTA_MB=500
RECEIPT_IMAGE_RETENTION_DAYS=90

# ---------- Trial / billing ----------
TRIAL_DAYS=14
PRO_MONTHLY_PRICE=14900
PRO_YEARLY_PRICE=149000
PRO_CURRENCY=TZS
BILLING_PROVIDER=manual
PUBLIC_APP_URL=https://app.pesalens.com

# Comma-separated admin emails — these accounts can confirm manual
# payments via the /upgrade flow.
BILLING_ADMINS=

# Manual M-Pesa / bank payout details. Surfaced on /upgrade when
# BILLING_PROVIDER=manual. Empty values cause checkout to return
# a "contact us" message instead of fake account numbers.
MANUAL_LIPA_NAMBA=
MANUAL_BANK_NAME=
MANUAL_BANK_ACCOUNT=
MANUAL_BANK_HOLDER=
MANUAL_SUPPORT_CONTACT=

# Stripe (only when BILLING_PROVIDER=stripe).
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_WEBHOOK_SECRET=

# ---------- Runtime tuning ----------
# Gunicorn worker count. Start at 2 on a 2-vCPU Contabo VPS; bump to
# (2 * vCPU) + 1 when you upgrade the box.
WEB_CONCURRENCY=2
